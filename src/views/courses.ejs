<h2 class="text-2xl font-bold text-gray-900 mb-6">课程列表</h2>

<% if (courses.length === 0) { %>
  <%- include('_components/empty-state', { title: '暂无课程', description: '管理员尚未添加任何课程' }) %>
<% } else { %>
  <div class="course-masonry">
    <% courses.forEach(function(c) { %>
      <%- include('_course-card', { c: c }) %>
    <% }); %>
  </div>
<% } %>

<script>
(function() {
  function formatCountdown(diff) {
    var d = Math.floor(diff / 86400000);
    var h = Math.floor((diff % 86400000) / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    if (d > 0) return d + "天" + h + "时" + m + "分";
    if (h > 0) return h + "时" + m + "分";
    return m + "分";
  }

  var openBtns = document.querySelectorAll("button[data-opentime]");
  var endSpans = document.querySelectorAll(".countdown-end");
  if (openBtns.length === 0 && endSpans.length === 0) return;

  var timer = setInterval(function() {
    var now = new Date();
    var anyActive = false;

    openBtns.forEach(function(btn) {
      var openTime = new Date(btn.getAttribute("data-opentime") + "+08:00");
      var diff = openTime - now;
      if (diff <= 0) {
        btn.textContent = "抢课";
        btn.disabled = false;
        btn.className = btn.className.replace(/bg-gray-100 text-gray-400 cursor-not-allowed/g, "bg-blue-600 text-white");
        location.reload();
        return;
      }
      anyActive = true;
      btn.textContent = formatCountdown(diff);
    });

    endSpans.forEach(function(el) {
      var endTime = new Date(el.getAttribute("data-endtime") + "+08:00");
      var diff = endTime - now;
      if (diff <= 0) {
        el.textContent = "已截止";
        return;
      }
      anyActive = true;
      el.textContent = "剩余" + formatCountdown(diff);
    });

    if (!anyActive) clearInterval(timer);
  }, 1000);
})();
</script>
