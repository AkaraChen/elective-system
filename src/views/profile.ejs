<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900">个人资料</h2>
    <p class="mt-1 text-sm text-gray-500">更新昵称、手机号、班级、年级或登录密码。</p>
  </div>

  <% if (typeof error !== "undefined" && error) { %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
  <% } %>

  <form method="POST" action="/api/profile" class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <%- include('_components/form-field', { label: '昵称', name: 'nickname', value: profile.nickname || '', required: true, maxlength: 100, autocomplete: 'name' }) %>

    <div class="mb-4">
      <label for="profile-phone" class="block text-sm font-medium text-gray-700 mb-1">手机号</label>
      <% if (!profile.phone) { %>
        <p class="mb-2 text-sm font-medium text-red-600">必须填写后访问</p>
      <% } %>
      <input id="profile-phone" name="phone" type="tel" required inputmode="numeric" autocomplete="tel"
        pattern="<%= phonePattern %>" maxlength="11" value="<%= profile.phone || '' %>"
        placeholder="11位中国大陆手机号"
        class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
    </div>

    <%- include('_components/form-field', { label: '班级', name: 'className', value: profile.className || '', pattern: '[0-9]+', inputmode: 'numeric', maxlength: 100 }) %>
    <%- include('_components/form-field', { label: '年级', name: 'grade', type: 'number', value: profile.grade == null ? '' : String(profile.grade), required: true, min: 1000, max: 9999, step: 1, placeholder: '例如 2026' }) %>
    <%- include('_components/form-field', { label: '新密码（留空不修改）', name: 'password', type: 'password', maxlength: 200, autocomplete: 'new-password', placeholder: '留空不修改' }) %>

    <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-700">保存资料</button>
  </form>
</div>
