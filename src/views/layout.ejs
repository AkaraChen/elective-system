<!DOCTYPE html>
<html lang="zh-CN" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== "undefined" ? title : (typeof siteTitle !== "undefined" ? siteTitle : "选课系统") %></title>
  <link rel="stylesheet" href="/style.css">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
</head>
<body class="h-full">
  <div class="htmx-loading-bar"></div>

  <% if (typeof user !== "undefined" && user) { %>
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-14 items-center">
          <a href="/" class="font-bold text-lg text-gray-900 shrink-0"><%= typeof siteTitle !== "undefined" ? siteTitle : "选课系统" %></a>

          <div class="hidden md:flex items-center space-x-1">
            <% if (user.isAdmin) { %>
              <a href="/admin/courses"
                 class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= currentPath === '/admin/courses' ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %>">课程</a>
              <a href="/admin/class"
                 class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= currentPath === '/admin/class' ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %>">班级</a>
              <a href="/admin/access"
                 class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= currentPath === '/admin/access' ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %>">批次</a>
              <a href="/admin/users"
                 class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= currentPath === '/admin/users' ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %>">用户</a>
            <% } else { %>
              <a href="/courses"
                 class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= currentPath === '/courses' ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %>">课程列表</a>
              <a href="/selections"
                 class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= currentPath === '/selections' ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %>">我的选课</a>
              <a href="/profile"
                 class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= currentPath === '/profile' ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %>">个人资料</a>
            <% } %>
            <span class="px-3 py-2 text-sm text-gray-500"><%= user.nickname %></span>
            <form action="/api/logout" method="POST" class="ml-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit"
                      class="px-3 py-2 rounded-md text-sm font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-50 transition-colors">退出</button>
            </form>
          </div>

          <div class="md:hidden relative">
            <input type="checkbox" id="menu-toggle" class="peer hidden" />
            <label for="menu-toggle" class="cursor-pointer p-2 rounded-md hover:bg-gray-100 block select-none" aria-label="菜单">
              <svg class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </label>
            <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 py-1 hidden peer-checked:block z-50">
              <% if (user.isAdmin) { %>
                <a href="/admin/courses"
                   class="block px-4 py-2 text-sm <%= currentPath === '/admin/courses' ? 'text-blue-700 bg-blue-50' : 'text-gray-700 hover:bg-gray-100' %>">课程</a>
                <a href="/admin/class"
                   class="block px-4 py-2 text-sm <%= currentPath === '/admin/class' ? 'text-blue-700 bg-blue-50' : 'text-gray-700 hover:bg-gray-100' %>">班级</a>
                <a href="/admin/access"
                   class="block px-4 py-2 text-sm <%= currentPath === '/admin/access' ? 'text-blue-700 bg-blue-50' : 'text-gray-700 hover:bg-gray-100' %>">批次</a>
                <a href="/admin/users"
                   class="block px-4 py-2 text-sm <%= currentPath === '/admin/users' ? 'text-blue-700 bg-blue-50' : 'text-gray-700 hover:bg-gray-100' %>">用户</a>
              <% } else { %>
                <a href="/courses"
                   class="block px-4 py-2 text-sm <%= currentPath === '/courses' ? 'text-blue-700 bg-blue-50' : 'text-gray-700 hover:bg-gray-100' %>">课程列表</a>
                <a href="/selections"
                   class="block px-4 py-2 text-sm <%= currentPath === '/selections' ? 'text-blue-700 bg-blue-50' : 'text-gray-700 hover:bg-gray-100' %>">我的选课</a>
                <a href="/profile"
                   class="block px-4 py-2 text-sm <%= currentPath === '/profile' ? 'text-blue-700 bg-blue-50' : 'text-gray-700 hover:bg-gray-100' %>">个人资料</a>
              <% } %>
              <hr class="my-1 border-gray-100" />
              <span class="block px-4 py-2 text-sm text-gray-500"><%= user.nickname %></span>
              <form action="/api/logout" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-500 hover:bg-gray-100">退出</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </nav>
  <% } %>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <%- body %>
  </main>

  <div id="toast-container" class="fixed top-4 right-4 z-[9999] flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]"></div>

  <script>
  (function() {
    var container = document.getElementById('toast-container');

    window.showToast = function(message, type) {
      type = type || 'info';
      var icons = {
        success: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
        error: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
        warning: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>',
        info: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>'
      };
      var colors = {
        success: 'bg-green-50 border-green-200 text-green-800',
        error: 'bg-red-50 border-red-200 text-red-800',
        warning: 'bg-yellow-50 border-yellow-200 text-yellow-800',
        info: 'bg-blue-50 border-blue-200 text-blue-800'
      };
      var toast = document.createElement('div');
      toast.className = 'flex items-start gap-3 rounded-lg border p-4 shadow-lg ' + (colors[type] || colors.info) + ' animate-slide-in';
      toast.innerHTML = '<span class="shrink-0">' + (icons[type] || icons.info) + '</span>' +
        '<p class="text-sm flex-1">' + message + '</p>' +
        '<button class="shrink-0 opacity-60 hover:opacity-100 transition-opacity" onclick="this.parentElement.remove()">' +
        '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>';
      container.appendChild(toast);
      setTimeout(function() {
        toast.classList.remove('animate-slide-in');
        toast.classList.add('animate-slide-out');
        setTimeout(function() { toast.remove(); }, 300);
      }, 3500);
    };

    document.body.addEventListener('toast', function(evt) {
      var detail = evt.detail || {};
      if (detail.message) showToast(detail.message, detail.type || 'info');
    });

    document.body.addEventListener('htmx:configRequest', function(evt) {
      var token = document.querySelector('meta[name="csrf-token"]');
      if (token) evt.detail.headers['x-csrf-token'] = token.content;
    });

    document.body.addEventListener('htmx:beforeRequest', function() {
      document.body.classList.add('htmx-request');
    });

    document.body.addEventListener('htmx:afterRequest', function(evt) {
      document.body.classList.remove('htmx-request');
      if (evt.detail.xhr && evt.detail.xhr.status >= 400) {
        var msg = evt.detail.xhr.responseText || '请求失败';
        showToast(msg.substring(0, 200), 'error');
      }
    });
  })();
  </script>
</body>
</html>
