<h2 class="text-2xl font-bold text-gray-900 mb-6">全局选课时间</h2>

<form method="POST" action="/api/admin/selection-window?_method=PUT" class="mb-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] items-end gap-3">
    <label class="text-sm font-medium text-gray-700">
      开始日期
      <input type="date" name="startTime"
        value="<%= typeof startTime === 'string' ? startTime.substring(0, 10) : '' %>"
        required
        class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
    </label>
    <label class="text-sm font-medium text-gray-700">
      截止日期
      <input type="date" name="endTime"
        value="<%= typeof endTime === 'string' ? endTime.substring(0, 10) : '' %>"
        required
        class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
    </label>
    <button type="submit" class="inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors whitespace-nowrap">
      保存选课时间
    </button>
  </div>
</form>
<p class="text-sm text-gray-500 -mt-4 mb-6">全年任意日期都可设置，允许同一天；开始日期不得晚于截止日期。系统按中国时间计算。</p>

<h2 class="text-2xl font-bold text-gray-900 mb-6">最大报课数</h2>

<form method="POST" action="/api/admin/config?_method=PUT" class="mb-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="key" value="max_selections">
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
    <input type="number" name="value"
      value="<%= typeof maxSelections === 'string' ? maxSelections : '1' %>"
      min="1"
      placeholder="正整数"
      required
      class="rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 flex-1" />
    <button type="submit" class="inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors whitespace-nowrap">
      保存最大报课数
    </button>
  </div>
</form>

<h2 class="text-2xl font-bold text-gray-900 mb-6">显示标题</h2>

<form method="POST" action="/api/admin/config?_method=PUT" class="mb-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="key" value="site_title">
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
    <input type="text" name="value"
      value="<%= typeof siteTitle === 'string' ? siteTitle : '选课系统' %>"
      placeholder="本系统显示的标题"
      required
      class="rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 flex-1" />
    <button type="submit" class="inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors whitespace-nowrap">
      保存标题
    </button>
  </div>
</form>

<h2 class="text-2xl font-bold text-gray-900 mb-4">课程列表</h2>

<details class="mb-6 bg-white rounded-xl shadow-sm border border-gray-100">
  <summary class="px-6 py-3 cursor-pointer text-sm font-medium text-gray-700 hover:text-gray-900 select-none">+ 新建课程</summary>
  <form method="POST" action="/api/admin/courses" class="px-6 pb-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <%- include('_components/form-field', { label: '课程名', name: 'name', required: true }) %>
      <%- include('_components/form-field', { label: '教师', name: 'teacher', required: true }) %>
      <%- include('_components/form-field', { label: '上课时间', name: 'courseTime' }) %>
      <%- include('_components/form-field', { label: '上课地点', name: 'location' }) %>
      <%- include('_components/form-field', { label: '总名额', name: 'totalSeats', type: 'number', value: '30', required: true }) %>
      <%- include('_components/form-field', { label: '默认开放时间', name: 'openTime', type: 'date', value: typeof defaultOpenTime === 'string' ? defaultOpenTime.substring(0, 10) : '', required: true }) %>
      <%- include('_components/form-field', { label: '允许年级', name: 'allowedGrades', placeholder: '例如 2024,2026；留空表示不限' }) %>
    </div>
    <%- include('_components/form-field', { label: '课程描述', name: 'description', type: 'textarea' }) %>
    <button type="submit" class="inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
      创建课程
    </button>
  </form>
</details>

<div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% courses.forEach(function(c) { %>
      <div id="course-wrapper-<%= c.id %>" class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div id="course-row-<%= c.id %>" class="grid grid-cols-1 gap-y-1.5 px-6 py-3 transition-colors">
          <div class="flex justify-between">
            <span class="text-xs text-gray-400">ID</span>
            <span class="text-sm text-gray-500"><%= c.id %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-xs text-gray-400">课程名</span>
            <span class="text-sm font-medium text-gray-900"><%= c.name %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-xs text-gray-400">教师</span>
            <span class="text-sm text-gray-600"><%= c.teacher %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-xs text-gray-400">上课时间</span>
            <span class="text-sm text-gray-600"><%= c.courseTime || "-" %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-xs text-gray-400">地点</span>
            <span class="text-sm text-gray-600"><%= c.location || "-" %></span>
          </div>
          <% if (c.description) { %>
            <div class="flex justify-between gap-4">
              <span class="text-xs text-gray-400 shrink-0">课程描述</span>
              <span class="course-description-preview text-sm text-gray-600 text-right"><%= String(c.description).slice(0, 100) %></span>
            </div>
          <% } %>
          <div class="flex justify-between">
            <span class="text-xs text-gray-400">开放时间</span>
            <span class="text-sm text-gray-600"><%= c.openTime ? c.openTime.substring(0, 10) : "-" %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-xs text-gray-400">允许年级</span>
            <span class="text-sm text-gray-600"><%= c.allowedGrades ? String(c.allowedGrades).split(',').map(function(g) { return g + '级'; }).join('、') : '不限' %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-xs text-gray-400">已选/总</span>
            <span class="text-sm font-medium <%= (c.selected_count || 0) >= c.totalSeats ? 'text-red-600' : 'text-green-600' %>"><%= c.selected_count || 0 %> / <%= c.totalSeats %></span>
          </div>
          <div class="flex justify-end gap-2 pt-1">
            <button onclick="document.getElementById('edit-<%= c.id %>').classList.toggle('hidden')" class="text-xs font-medium rounded-lg px-2.5 py-1.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors">
              编辑
            </button>
            <button hx-delete="/api/admin/courses/<%= c.id %>"
                    hx-confirm="确定删除该课程？这将同步删除课程相关的批次。"
                    hx-target="#course-wrapper-<%= c.id %>"
                    hx-swap="delete"
                    class="text-xs font-medium rounded-lg px-2.5 py-1.5 bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 transition-colors">
              删除
            </button>
          </div>
        </div>

        <div id="edit-<%= c.id %>" class="hidden border-t border-dashed border-gray-200 px-6 py-4 bg-gray-50/50">
          <form method="POST" action="/api/admin/courses/<%= c.id %>?_method=PUT">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <%- include('_components/form-field', { label: '课程名', name: 'name', value: c.name, required: true }) %>
              <%- include('_components/form-field', { label: '教师', name: 'teacher', value: c.teacher, required: true }) %>
              <%- include('_components/form-field', { label: '上课时间', name: 'courseTime', value: c.courseTime || '' }) %>
              <%- include('_components/form-field', { label: '上课地点', name: 'location', value: c.location || '' }) %>
              <%- include('_components/form-field', { label: '总名额', name: 'totalSeats', type: 'number', value: String(c.totalSeats), required: true }) %>
              <%- include('_components/form-field', { label: '默认开放时间', name: 'openTime', type: 'date', value: c.openTime ? c.openTime.substring(0, 10) : '' }) %>
              <%- include('_components/form-field', { label: '允许年级', name: 'allowedGrades', value: c.allowedGrades || '', placeholder: '例如 2024,2026；留空表示不限' }) %>
            </div>
            <%- include('_components/form-field', { label: '课程描述', name: 'description', type: 'textarea', value: c.description || '' }) %>
            <div class="flex items-center justify-between gap-2 pt-1">
              <button type="submit" class="inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 transition-colors">保存</button>
              <button type="button" onclick="document.getElementById('edit-<%= c.id %>').classList.add('hidden')" class="inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors">取消</button>
          </div>
        </form>
      </div>
      </div>
    <% }); %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('form[action*="_method=PUT"]').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var url = form.getAttribute('action');
      var method = 'POST';
      var realUrl = url.replace('?_method=PUT', '').replace('?_method=DELETE', '');
      if (url.indexOf('_method=DELETE') !== -1) method = 'DELETE';
      else if (url.indexOf('_method=PUT') !== -1) method = 'PUT';

      var formData = new FormData(form);
      var params = new URLSearchParams();
      formData.forEach(function(v, k) { if (k !== '_method') params.append(k, v); });

      fetch(realUrl, {
        method: method,
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
      }).then(function(res) {
        if (res.redirected) {
          window.location.href = res.url;
        } else if (res.ok) {
          window.location.reload();
        } else {
          res.text().then(function(t) { alert(t); });
        }
      });
    });
  });
});
</script>
