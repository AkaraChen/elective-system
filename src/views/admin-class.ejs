<h2 class="text-2xl font-bold text-gray-900 mb-4">班级管理</h2>

<form id="class-search-form" class="mb-6"
      hx-get="/api/admin/class/courses/search"
      hx-target="#class-search-result"
      hx-indicator="#class-search-indicator">
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
    <input type="text" name="name" placeholder="输入课程名"
      required
      list="course-list"
      autocomplete="off"
      class="rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 flex-1" />
    <datalist id="course-list">
      <% allCourses.forEach(function(c) { %>
        <option value="<%= c.name %>">
      <% }); %>
    </datalist>
    <button type="submit" class="inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors whitespace-nowrap">
      查询
    </button>
  </div>
</form>

<div id="class-search-result" class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
  <div id="class-search-indicator" class="htmx-indicator px-6 py-4 text-sm text-gray-400">查询中...</div>
</div>

<script>
(function() {
  var allStudents = <%- JSON.stringify(allStudents) %>;
  var studentMap = {};
  allStudents.forEach(function(s) { studentMap[s.username] = s.id; });

  var SPLIT_RE = /[\s,，;；、\n\r]+/;

  window.addStudentsToEdit = function(btn) {
    var container = btn.closest('[id^="edit-class-"]');
    var textarea = container.querySelector('.edit-student-input');
    var badgesEl = container.querySelector('.student-badges');
    var hiddenEl = container.querySelector('.hidden-inputs-container');
    var unmatchedEl = container.querySelector('.edit-unmatched');

    var raw = textarea.value.split(SPLIT_RE).filter(Boolean);
    textarea.value = '';
    var unmatched = [];

    raw.forEach(function(name) {
      var userId = studentMap[name];
      if (!userId) { unmatched.push(name); return; }
      if (hiddenEl.querySelector('input[value="' + userId + '"]')) return;
      addBadge(badgesEl, name, userId, true);
      var inp = document.createElement('input');
      inp.type = 'hidden';
      inp.name = 'user_ids';
      inp.value = userId;
      hiddenEl.appendChild(inp);
    });

    if (unmatched.length > 0) {
      unmatchedEl.textContent = '未识别：' + unmatched.join('、');
      unmatchedEl.classList.remove('hidden');
    } else {
      unmatchedEl.classList.add('hidden');
    }
  };

  window.removeStudentBadge = function(btn) {
    var badge = btn.parentElement;
    var container = btn.closest('[id^="edit-class-"]');
    var hiddenEl = container.querySelector('.hidden-inputs-container');
    var userId = badge.getAttribute('data-user-id');
    badge.remove();
    var inp = hiddenEl.querySelector('input[value="' + userId + '"]');
    if (inp) inp.remove();
    if (container.querySelector('.student-badges').children.length === 0) {
      container.querySelector('.student-badges').innerHTML = '<span class="text-xs text-gray-400">暂无学生</span>';
    }
  };

  function addBadge(container, name, userId, removable) {
    var ph = container.querySelector('.text-xs.text-gray-400');
    if (ph) ph.remove();

    var badge = document.createElement('span');
    badge.className = 'inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2.5 py-0.5 text-xs font-medium text-blue-700';
    badge.setAttribute('data-user-id', userId);
    badge.innerHTML = name;
    if (removable) {
      badge.innerHTML += '<button type="button" onclick="removeStudentBadge(this)" class="inline-flex items-center justify-center w-4 h-4 rounded-full text-blue-400 hover:text-red-500 hover:bg-red-50 transition-colors" title="移除">&times;</button>';
    }
    container.appendChild(badge);
  }

  document.addEventListener('submit', function(e) {
    var form = e.target.closest('form[action*="_method=PUT"]');
    if (!form) return;
    e.preventDefault();
    var url = form.getAttribute('action');
    var realUrl = url.replace('?_method=PUT', '');

    var formData = new FormData(form);
    var params = new URLSearchParams();
    formData.forEach(function(v, k) { if (k !== '_method') params.append(k, v); });

    fetch(realUrl, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: params.toString()
    }).then(function(res) {
      if (res.ok) {
        res.text().then(function(html) {
          var resultArea = document.getElementById('class-search-result');
          if (resultArea) resultArea.innerHTML = html;
        });
      } else {
        res.text().then(function(t) { alert(t); });
      }
    });
  });
})();
</script>
