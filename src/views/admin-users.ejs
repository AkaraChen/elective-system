<h2 class="text-2xl font-bold text-gray-900 mb-4">用户管理</h2>

<details class="mb-6 bg-white rounded-xl shadow-sm border border-gray-100">
  <summary class="px-6 py-3 cursor-pointer text-sm font-medium text-gray-700 hover:text-gray-900 select-none">+ 新建用户</summary>
  <form method="POST" action="/api/admin/users" class="px-6 pb-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
      <%- include('_components/form-field', { label: '用户名', name: 'username', required: true }) %>
      <%- include('_components/form-field', { label: '昵称', name: 'nickname', required: true }) %>
      <%- include('_components/form-field', { label: '密码', name: 'password', type: 'password', required: true }) %>
      <%- include('_components/form-field', { label: '角色', name: 'isAdmin', type: 'select', required: true, options: '<option value="0">学生</option><option value="1">管理员</option>' }) %>
      <%- include('_components/form-field', { label: '年级', name: 'grade', type: 'number', placeholder: '例如 2026' }) %>
    </div>
    <button type="submit" class="inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 transition-colors mt-2">创建用户</button>
  </form>
</details>

<h3 class="text-lg font-bold text-gray-900 mb-4">学生列表</h3>

<form id="student-search-form" class="mb-4"
      hx-get="/api/admin/users/search"
      hx-target="#student-result"
      hx-indicator="#student-search-indicator">
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
    <input type="text" name="username" placeholder="输入学生用户名"
      required
      class="rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 flex-1" />
    <button type="submit" class="inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors whitespace-nowrap">
      查询
    </button>
  </div>
</form>

<div id="student-result" class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
  <div id="student-search-indicator" class="htmx-indicator px-6 py-4 text-sm text-gray-400">查询中...</div>
</div>

<h3 class="text-lg font-bold text-gray-900 mb-4">管理员列表</h3>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
  <div class="hidden md:grid md:grid-cols-6 gap-2 px-6 py-3 bg-gray-50 border-b border-gray-100 text-xs font-medium text-gray-500 uppercase tracking-wider">
    <span>ID</span>
    <span>用户名</span>
    <span>昵称</span>
    <span>角色</span>
    <span>年级</span>
    <span class="text-center">操作</span>
  </div>

  <div class="divide-y divide-gray-50">
    <% admins.forEach(function(u) { %>
      <%- include('_user-row', { u: u }) %>
    <% }); %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.addEventListener('submit', function(e) {
    var form = e.target.closest('form[action*="_method=PUT"]');
    if (!form) return;
    e.preventDefault();
    var realUrl = form.getAttribute('action').replace('?_method=PUT', '');

    var formData = new FormData(form);
    var params = new URLSearchParams();
    formData.forEach(function(v, k) { if (k !== '_method') params.append(k, v); });

    fetch(realUrl, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: params.toString()
    }).then(function(res) {
      if (res.redirected) {
        window.location.href = res.url;
      } else if (res.ok) {
        window.location.reload();
      } else {
        res.text().then(function(t) { alert(t); });
      }
    });
  });
});
</script>
