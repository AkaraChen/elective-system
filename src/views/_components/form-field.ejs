<%
  var label = locals.label !== undefined ? locals.label : "";
  var name = locals.name !== undefined ? locals.name : "";
  var type = locals.type !== undefined ? locals.type : "text";
  var value = locals.value !== undefined ? locals.value : "";
  var placeholder = locals.placeholder !== undefined ? locals.placeholder : "";
  var required = locals.required !== undefined && locals.required;
  var autocomplete = locals.autocomplete !== undefined ? locals.autocomplete : "";
  var pattern = locals.pattern !== undefined ? locals.pattern : "";
  var inputmode = locals.inputmode !== undefined ? locals.inputmode : "";
  var maxlength = locals.maxlength !== undefined ? locals.maxlength : "";
  var error = locals.error !== undefined && locals.error;
  var id = "field-" + name;
%>
<div class="mb-4">
  <% if (label) { %>
    <label for="<%= id %>" class="block text-sm font-medium text-gray-700 mb-1"><%= label %></label>
  <% } %>
  <% if (type === "textarea") { %>
    <textarea id="<%= id %>" name="<%= name %>" <%= required ? "required" : "" %>
      class="w-full rounded-lg border <%= error ? 'border-red-300 text-red-900 focus:ring-red-500 focus:border-red-500' : 'border-gray-300 focus:ring-blue-500 focus:border-blue-500' %> px-3 py-2 text-sm shadow-sm focus:outline-none"
      placeholder="<%= placeholder %>"><%= value %></textarea>
  <% } else if (type === "select") { %>
    <select id="<%= id %>" name="<%= name %>" <%= required ? "required" : "" %>
      class="w-full rounded-lg border <%= error ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500' %> px-3 py-2 text-sm shadow-sm focus:outline-none">
      <%- locals.options !== undefined ? locals.options : "" %>
    </select>
  <% } else { %>
    <input type="<%= type %>" id="<%= id %>" name="<%= name %>" value="<%= value %>"
      <%= required ? "required" : "" %> placeholder="<%= placeholder %>" <%= autocomplete ? 'autocomplete="' + autocomplete + '"' : '' %>
      <%= pattern ? 'pattern="' + pattern + '"' : '' %> <%= inputmode ? 'inputmode="' + inputmode + '"' : '' %> <%= maxlength ? 'maxlength="' + maxlength + '"' : '' %>
      class="w-full rounded-lg border <%= error ? 'border-red-300 text-red-900 focus:ring-red-500 focus:border-red-500' : 'border-gray-300 focus:ring-blue-500 focus:border-blue-500' %> px-3 py-2 text-sm shadow-sm focus:outline-none" />
  <% } %>
  <% if (error) { %>
    <p class="mt-1 text-sm text-red-600"><%= error %></p>
  <% } %>
</div>
