{
  "name": "elective-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n css,app \"npm run build:css:watch\" \"tsx watch src/index.ts\"",
    "start": "npm run build:css && tsx src/index.ts",
    "build:css": "tailwindcss -i src/css/input.css -o public/style.css",
    "build:css:watch": "tailwindcss -i src/css/input.css -o public/style.css --watch",
    "db:prepare": "node -e \"require('fs').mkdirSync('data',{recursive:true})\"",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:push": "npm run db:prepare && drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:init": "npm run db:prepare && npm run db:migrate && npm run db:push && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4",
    "better-sqlite3": "^11.7",
    "drizzle-orm": "^0.45.2",
    "ejs": "^3.1",
    "express": "^4.21",
    "express-session": "^1.18",
    "tsx": "^4.19"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4",
    "@types/better-sqlite3": "^7.6",
    "@types/ejs": "^3.1",
    "@types/express": "^5.0",
    "@types/express-session": "^1.18",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7"
  }
}
